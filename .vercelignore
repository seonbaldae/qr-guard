# Upload public frontend and only the stateless Python API's source closure.
/*
!index.html
!src
!assets
!api
/api/*
!/api/analyze.py
!/api/health.py
!/api/capabilities.py
!app
/app/*
!/app/__init__.py
!/app/public_api.py
!/app/cloud_worker.py
!/app/cloud_phishpedia.py
!/app/config.py
!/app/models.py
!/app/static_adapter.py
!/app/precheck
!requirements.txt
!.python-version
!scripts
/scripts/*
!/scripts/prepare-vercel.mjs
!vercel.json

# Do not upload hidden files, credentials, or local generated files.
**/.*
!/.python-version
dist/
node_modules/
