# Server only. Never put this value in src/, assets/ or Vercel static output.
GOOGLE_SAFE_BROWSING_API_KEY=

# Server-only cloud browser. Set exactly one source: an immutable VCR image
# reference ending in @sha256:<digest>, or a prepared Vercel Sandbox snap_ ID.
# Keep verification false until the real VM network firewall,
# IPv6 disablement, Chromium sandbox and PNG return path have been checked.
# Set these in the Vercel server environment; local scripts do not auto-load them.
QR_GUARD_CLOUD_WORKER_IMAGE=
QR_GUARD_CLOUD_WORKER_SNAPSHOT=
QR_GUARD_CLOUD_WORKER_VERIFIED=false

# Optional server-only Phishpedia runtime, separate from the browser snapshot.
# Prepare pinned model weights, reference logos and feature caches before saving it.
# Inference receives only the current PNG and final URL in a deny-all network VM.
# Never include credentials, scan inputs, results or screenshots in the base snapshot.
QR_GUARD_PHISHPEDIA_SNAPSHOT=

# Public build: node scripts/prepare-vercel.mjs --public --cloud-preview
# Frontend request limit: 270 seconds. Vercel Function limit: 300 seconds.
# The selected image or snapshot starts a disposable VM once per request.
# Request cleanup preserves the source snapshot; do not snapshot URL/result files.
# Never pass the Google key or Vercel/OIDC credentials into that VM.

# scripts/run-local.py configures and verifies the isolated local Worker.
# Run with a single API process: scan state and report counts are in memory.
