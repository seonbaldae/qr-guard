FROM seonbaldae-phishpedia-env

WORKDIR /opt/phishpedia

ENV KMP_DUPLICATE_LIB_OK=TRUE
ENV MAX_JOBS=2
ENV OMP_NUM_THREADS=2
ENV MKL_NUM_THREADS=2

# 최신 gdown 문법에 맞게 --id 옵션 제거
RUN sed -i 's/gdown --id /gdown /g' setup.sh \
    && bash ./setup.sh

# 실행 때마다 호스트의 .cache 파일을 요구하지 않도록 이미지 안에서 한 번 생성합니다.
RUN pixi run python -c "from phishpedia import PhishpediaWrapper; PhishpediaWrapper()" \
    && test -s LOGO_FEATS.npy \
    && test -s LOGO_FILES.npy

CMD ["pixi", "run", "python", "--version"]
